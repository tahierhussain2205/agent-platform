    {
      "id": "BZuSE1gwhaaJWznChWxnd",
      "type": "text",
      "x": 119,
      "y": 857.5,
      "width": 842,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e5e5e5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 456566064,
      "version": 2,
      "versionNonce": 1423279568,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792222490295,
      "link": null,
      "locked": false,
      "text": "Otherwise: needs approval. The requester, an admin, or a holder of the approver role decides,\nwith buttons in the thread. Irreversible actions always end here.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 38,
      "containerId": "fin",
      "originalText": "Otherwise: needs approval. The requester, an admin, or a holder of the approver role decides,\nwith buttons in the thread. Irreversible actions always end here.",
      "lineHeight": 1.25
    },
    {
      "id": "aVrKe0vF3nVr4PtU3U3iw",
      "type": "text",
      "x": 1170,
      "y": 167.5,
      "width": 300,
      "height": 135,
      "angle": 0,
      "strokeColor": "#e5e5e5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 831160112,
      "version": 2,
      "versionNonce": 1640254416,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792222490296,
      "link": null,
      "locked": false,
      "text": "The credential for the call\nfollows the operation's mode:\norg: the org's connection\norg_with_check: the org's, then\nresults filtered to the requester\nuser_required: their own link",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 128,
      "containerId": "n1",
      "originalText": "The credential for the call\nfollows the operation's mode:\norg: the org's connection\norg_with_check: the org's, then\nresults filtered to the requester\nuser_required: their own link",
      "lineHeight": 1.25
    },
    {
      "id": "G6ZGODBA2cdE5SetdF02N",
      "type": "text",
      "x": 1192.5,
      "y": 421.25,
      "width": 255,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#e5e5e5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1146296624,
      "version": 2,
      "versionNonce": 820662736,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792222490296,
      "link": null,
      "locked": false,
      "text": "Every decision is audited:\nwhat, for whom, the outcome\nand the reason.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 60,
      "containerId": "n2",
      "originalText": "Every decision is audited:\nwhat, for whom, the outcome\nand the reason.",
      "lineHeight": 1.25
    },
    {
      "id": "MYrw8eDFPFLCbGG2TpUUK",
      "type": "text",
      "x": 1180,
      "y": 617.5,
      "width": 280,
      "height": 135,
      "angle": 0,
      "strokeColor": "#e5e5e5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1727558448,
      "version": 2,
      "versionNonce": 2036307920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792222490296,
      "link": null,
      "locked": false,
      "text": "Outputs get a check too:\nif someone at the destination\ncannot see one of the sources,\nthe answer goes privately\nto the requester, with a note\nin the thread.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 128,
      "containerId": "n3",
      "originalText": "Outputs get a check too:\nif someone at the destination\ncannot see one of the sources,\nthe answer goes privately\nto the requester, with a note\nin the thread.",
      "lineHeight": 1.25
    }
  ],

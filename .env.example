# Every environment variable the backend reads, grouped by component.
# Copy to .env for local runs. On Render, shared values live in environment groups
# and secrets are `sync: false` variables entered in the dashboard (never committed).

# ---------------------------------------------------------------- common
# One of: local, test, staging, production
ENV=local
# Port to listen on. Render sets this; never hardcode a port.
PORT=8000
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# JSON lines (true, production) or human readable lines (false)
LOG_JSON=true
# OTLP/HTTP collector base URL (Jaeger locally: http://localhost:4318). Empty: traces not exported.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------- database
# Direct (non pooled) connection used only by `migrate` and `seed`. Never point it at PgBouncer:
# the migration runner holds a session advisory lock.
# Locally this is the Render-like database owner `agent_admin` (CREATEROLE, not a superuser).
MIGRATION_DATABASE_URL=postgresql://agent_admin:agent_admin@localhost:55432/agent
# Application traffic. On Render: the PgBouncer connectionPoolString. Each component replaces the
# user and password with its own login user (api_service, worker_service, vault_service,
# identity_service, maintenance_service), created by `app migrate` from the passwords below.
DATABASE_URL=postgresql://unused:unused@localhost:55432/agent
# At least 16 characters. On Render: generated env groups (db-<component>-staging).
DB_API_PASSWORD=local-api-password-0001
DB_WORKER_PASSWORD=local-worker-password-0001
DB_VAULT_PASSWORD=local-vault-password-0001
DB_IDENTITY_PASSWORD=local-identity-password-0001
DB_MAINTENANCE_PASSWORD=local-maintenance-password-0001
# Pool size per process and component.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ---------------------------------------------------------------- key value
# Redis compatible URL (Render Key Value internal URL in production). Used from phase 4.
REDIS_URL=redis://localhost:56379/0

# ---------------------------------------------------------------- console auth (Clerk)
# Browser origins of the console: CORS and the allowed Clerk `azp` claims (comma separated).
CONSOLE_ORIGINS=http://localhost:5173
# Clerk instance Frontend API URL (the `iss` of session tokens). Local: the fakes service.
CLERK_ISSUER=http://localhost:4100/clerk
# JWKS: <frontend api>/.well-known/jwks.json, or https://api.clerk.com/v1/jwks (uses the secret key).
CLERK_JWKS_URL=http://localhost:4100/clerk/.well-known/jwks.json
# Backend API base URL and secret key (console invites, role changes, removals go to Clerk).
CLERK_API_URL=http://localhost:4100/clerk/v1
CLERK_SECRET_KEY=sk_test_local
# Svix signing secret(s) of the Clerk webhook endpoint (comma separated during rotation).
CLERK_WEBHOOK_SECRET=whsec_bG9jYWwtY2xlcmstd2ViaG9vay1zZWNyZXQtMDAwMQ==

# ---------------------------------------------------------------- Slack
# Public base URL of the API: Slack's OAuth redirect is <API_PUBLIC_URL>/slack/oauth/callback, and the
# Slack app's event and interactivity URLs are <API_PUBLIC_URL>/slack/events and /slack/interactions.
API_PUBLIC_URL=http://localhost:8000
# Console base URL: the OAuth callback redirects to <CONSOLE_URL>/slack, Slack messages link here.
CONSOLE_URL=http://localhost:5173
# Web API and OAuth authorize URLs. Local: the Slack stand-in. Real Slack (the defaults):
# https://slack.com/api and https://slack.com/oauth/v2/authorize
SLACK_API_URL=http://localhost:4100/slack/api
SLACK_AUTHORIZE_URL=http://localhost:4100/slack/oauth/v2/authorize
# Slack app credentials (the app's Basic Information page). Without them install and ingress refuse.
SLACK_CLIENT_ID=local.client
SLACK_CLIENT_SECRET=local-slack-client-secret
SLACK_SIGNING_SECRET=local-slack-signing-secret
# Signs the OAuth state parameter. Any random string (Render generates it).
SLACK_STATE_SECRET=local-slack-state-secret

# ---------------------------------------------------------------- models (LLM gateway)
# Anthropic Messages API base URL and key. Local: the Anthropic stand-in. Real: https://api.anthropic.com
ANTHROPIC_API_URL=http://localhost:4100/anthropic
ANTHROPIC_API_KEY=sk-ant-local-key
# Optional second route tried when the first keeps failing (another endpoint or region).
ANTHROPIC_FALLBACK_API_URL=
ANTHROPIC_FALLBACK_API_KEY=
# Model per tier. Admins pick tiers in the console; operators map tiers to models here.
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_STANDARD=claude-sonnet-5
MODEL_ADVANCED=claude-opus-5-5
# Model requests per minute per org (interactive lane, batch lane for schedules).
LLM_ORG_RPM=120
LLM_ORG_BATCH_RPM=30
# Default token budget per task, and how long approval requests stay open (hours).
TASK_TOKEN_BUDGET=300000
APPROVAL_TTL_HOURS=24

# ---------------------------------------------------------------- data lifecycle and alerts
# Days before an offboarding org's data is deleted; months of usage events and audit log kept.
# OFFBOARDING_GRACE_DAYS=7
# USAGE_RETENTION_MONTHS=13
# AUDIT_RETENTION_MONTHS=13
# Alerts from the maintenance job: a Slack incoming webhook (unset: logged only) and thresholds.
# ALERT_WEBHOOK_URL=
# ALERT_FAILURE_RATE=0.25
# ALERT_MIN_FINISHED=8
# ALERT_QUEUE_DEPTH=50
# ALERT_QUEUE_AGE_MINUTES=10
# ALERT_INGRESS_P95_MS=1500
# ALERT_INGRESS_P99_MS=2500

# ---------------------------------------------------------------- token vault service
# Scheduled reports: random delay per run (seconds) and how late a missed run may still start (minutes).
# SCHEDULE_JITTER_SECONDS=300
# SCHEDULE_CATCHUP_MINUTES=60

# The API and worker call the vault at VAULT_URL with VAULT_SERVICE_TOKEN (Render: the vault's private
# service address, the token from a generated env group). Unset VAULT_URL: in process vault.
VAULT_URL=http://localhost:8100
VAULT_SERVICE_TOKEN=local-vault-service-token
# Signs the OAuth state of integration connect and link flows.
OAUTH_STATE_SECRET=local-oauth-state-secret

# ---------------------------------------------------------------- integrations (B-007)
# Client ids are used by the API (authorize URLs); client secrets and the GitHub App key only by the
# vault. *_AUTHORIZE_URL, GITHUB_WEB_URL and GOOGLE_AUTH_URL are opened by the browser; the others are
# called by the vault and worker. Local values point at the stand-ins in the fakes service.
ATLASSIAN_AUTHORIZE_URL=http://localhost:4100/atlassian/authorize
ATLASSIAN_TOKEN_URL=http://localhost:4100/atlassian/oauth/token
ATLASSIAN_API_URL=http://localhost:4100/atlassian/api
ATLASSIAN_CLIENT_ID=local-jira-client
ATLASSIAN_CLIENT_SECRET=local-jira-client-secret
GITHUB_WEB_URL=http://localhost:4100/github
GITHUB_TOKEN_URL=http://localhost:4100/github/login/oauth/access_token
GITHUB_API_URL=http://localhost:4100/github/api
GITHUB_APP_ID=424242
GITHUB_APP_SLUG=agent-platform-local
# PEM of the GitHub App's private key; one line values may use \n escapes. Local: dev/github/.
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=Iv1.localclient
GITHUB_CLIENT_SECRET=local-github-client-secret
# Verifies X-Hub-Signature-256 on /webhooks/github (the GitHub App's webhook secret).
GITHUB_WEBHOOK_SECRET=local-github-webhook-secret
GOOGLE_AUTH_URL=http://localhost:4100/google/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=http://localhost:4100/google/token
GOOGLE_REVOKE_URL=http://localhost:4100/google/revoke
GOOGLE_USERINFO_URL=http://localhost:4100/google/userinfo
# Vendor MCP endpoint for Google Workspace tools.
GOOGLE_MCP_URL=http://localhost:4100/google/mcp
GOOGLE_CLIENT_ID=local-google-client
GOOGLE_CLIENT_SECRET=local-google-client-secret
# Google Cloud for logs, errors and traces: the stand-in locally (the defaults are Google's real
# endpoints). The service account key is uploaded by an admin in the console and kept by the vault.
GCP_TOKEN_URL=http://localhost:4100/gcp/token
GCP_LOGGING_URL=http://localhost:4100/gcp/logging
GCP_ERROR_REPORTING_URL=http://localhost:4100/gcp/errorreporting
GCP_TRACE_URL=http://localhost:4100/gcp/trace
# Sandbox provider for repository work (worker and maintenance; B-008: the stand-in locally).
SANDBOX_URL=http://localhost:4100/sandbox/v1
SANDBOX_API_KEY=sbx-local-key

# ---------------------------------------------------------------- web console build (Vite)
# VITE_API_URL=http://localhost:8000
# Set to use real Clerk in the console; unset uses the local Clerk stand-in (VITE_DEV_AUTH_URL).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_DEV_AUTH_URL=http://localhost:4100/clerk

# ---------------------------------------------------------------- encryption
# Master keys for envelope encryption: comma separated "<version>:<base64 32 bytes>". Keep old
# versions listed until every ciphertext is re-wrapped. Generate a key with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=v1:bG9jYWwtZGV2LWtleS0wMDAwMDAwMDAwMDAwMDAwMDA=
# Version used for new secrets.
ENCRYPTION_ACTIVE_KEY=v1

# ---------------------------------------------------------------- object storage
# S3 compatible store. Local: SeaweedFS. Staging/production: Cloudflare R2 (region "auto").
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=artifacts
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key

# ---------------------------------------------------------------- temporal
# Local: the Compose dev server. Production: Temporal Cloud (B-006).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-tasks
# Temporal Cloud API key. Setting it switches the client to TLS. Leave empty for the dev server.
TEMPORAL_API_KEY=
# Seconds a stopping worker waits for in-flight activities (keep below Render's maxShutdownDelaySeconds).
WORKER_GRACEFUL_SHUTDOWN_SECONDS=60

# ---------------------------------------------------------------- tests only
# Admin connection used to create throwaway test databases.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:55432/postgres
TEST_TEMPORAL_ADDRESS=localhost:7233
TEST_PGBOUNCER_HOSTPORT=localhost:56432
TEST_REDIS_URL=redis://localhost:56379/15
TEST_S3_ENDPOINT=http://localhost:8333
